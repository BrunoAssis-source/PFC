# Copie para .env e preencha. O arquivo .env nao e versionado.

# Gere com: python -c "from django.core.management.utils import get_random_secret_key; print(get_random_secret_key())"
DJANGO_SECRET_KEY=

# 1 durante o desenvolvimento, 0 em producao
DJANGO_DEBUG=1

# Separados por virgula. Obrigatorio quando DJANGO_DEBUG=0
DJANGO_ALLOWED_HOSTS=
# Origens HTTPS autorizadas para formularios, separadas por virgula
CSRF_TRUSTED_ORIGINS=

# Chave da API transacional do Brevo. Obrigatoria apenas com DJANGO_DEBUG=0.
# Vazia no desenvolvimento, o email vai para o terminal em vez da API.
BREVO_API_KEY=

# Precisa ser um remetente verificado na conta do Brevo
EMAIL_REMETENTE=UniData <noreply@alunos.umc.br>

# Banco PostgreSQL. O docker-compose.yml usa os mesmos valores para criar o container.
DB_NAME=unidata
DB_USER=unidata
DB_PASSWORD=
DB_HOST=localhost
DB_PORT=5432
# Use require com o Neon. Sem a variável vale prefer, que serve ao container local.
DB_SSLMODE=prefer

# Chaves do CPF do voluntario. Gere cada uma como descrito no README e guarde fora do repositorio.
# CHAVE_HMAC gera o codigo de busca. CHAVE_CIFRA cifra o CPF. Perder a segunda torna os CPFs irrecuperaveis.
CHAVE_HMAC=
CHAVE_CIFRA=
